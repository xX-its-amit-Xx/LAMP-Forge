# LAMP-Forge environment configuration.
# Copy to .env, fill in, and `docker compose up` will pick these up.

# --- General ---
LAMP_FORGE_ENV=development              # development | staging | production
LAMP_FORGE_BASE_URL=http://localhost:8000
LAMP_FORGE_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
LAMP_FORGE_LOG_JSON=true                # false for pretty dev logs

# --- Ports ---
LAMP_FORGE_WEB_PORT=8000
LAMP_FORGE_HTTP_PORT=80
LAMP_FORGE_HTTPS_PORT=443

# --- Workers / concurrency ---
LAMP_FORGE_WORKER_REPLICAS=1            # bump for more concurrent jobs

# --- API keys ---
# Comma-separated list of accepted API keys. Generate strong values, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# In development, leave empty to disable auth.
LAMP_FORGE_API_KEYS=
LAMP_FORGE_ADMIN_API_KEYS=

# --- CORS ---
LAMP_FORGE_CORS_ORIGINS=http://localhost:8000,http://localhost

# --- NCBI ---
# Courtesy email required by Entrez. API key raises rate limit 3 → 10 req/sec.
NCBI_EMAIL=you@your-inst.edu
NCBI_API_KEY=
